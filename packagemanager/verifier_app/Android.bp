package {
    default_team: "trendy_team_framework_android_packages",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_defaults {
    name: "CtsRootVerifierApp_defaults",
    defaults: ["cts_defaults"],
    srcs: [
        "src/**/*.java",
    ],
    sdk_version: "test_current",
    // tag this module as a cts test artifact
    test_suites: [
        "cts",
        "general-tests",
    ],
    static_libs: [
        "androidx.appcompat_appcompat",
        "androidx.preference_preference",
        "android.content.pm.flags-aconfig-java",
        "CtsRootDeveloperVerificationUtils",
    ],
}

android_test_helper_app {
    name: "CtsRootVerifierApp",
    defaults: ["CtsRootVerifierApp_defaults"],
    manifest: "AndroidManifest.xml",
}

android_test_helper_app {
    name: "CtsRootVerifierAppV2",
    defaults: ["CtsRootVerifierApp_defaults"],
    manifest: "AndroidManifest_V2.xml",
}

android_test_helper_app {
    name: "CtsRootVerifierAppV3",
    defaults: ["CtsRootVerifierApp_defaults"],
    manifest: "AndroidManifest_V3.xml",
}

android_test_helper_app {
    name: "CtsRootSingletonVerifierApp",
    defaults: ["CtsRootVerifierApp_defaults"],
    manifest: "AndroidManifest_Singleton.xml",
}
