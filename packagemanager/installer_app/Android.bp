package {
    default_team: "trendy_team_framework_android_packages",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_defaults {
    name: "cts_root_installer_app_defaults",
    defaults: ["cts_defaults"],
    srcs: [
        "src/**/*.java",
    ],
    sdk_version: "current",
    // tag this module as a cts test artifact
    test_suites: [
        "general-tests",
    ],
    static_libs: [
        "CtsRootDeveloperVerificationUtils",
    ],
    package_splits: [
        "mdpi-v4",
    ],
}

android_test_helper_app {
    name: "CtsRootPrivInstallerAppTarget37",
    defaults: ["cts_root_installer_app_defaults"],
    min_sdk_version: "33",
    target_sdk_version: "37",
    package_name: "android.content.pm.cts_root.privinstallerapp",
    manifest: "AndroidManifest.xml",
    additional_manifests: [
        "AndroidManifestPrivInstallerPermission.xml",
    ],
}

android_test_helper_app {
    name: "CtsRootInstallerAppTarget37",
    defaults: ["cts_root_installer_app_defaults"],
    min_sdk_version: "33",
    target_sdk_version: "37",
    manifest: "AndroidManifest.xml",
    additional_manifests: [
        "AndroidManifestInstallerPermission.xml",
    ],
}

android_test_helper_app {
    name: "CtsRootPrivInstallerAppTarget36",
    defaults: ["cts_root_installer_app_defaults"],
    min_sdk_version: "33",
    target_sdk_version: "36",
    package_name: "android.content.pm.cts_root.privinstallerapp",
    manifest: "AndroidManifest.xml",
    additional_manifests: [
        "AndroidManifestPrivInstallerPermission.xml",
    ],
}

android_test_helper_app {
    name: "CtsRootInstallerAppTarget36",
    defaults: ["cts_root_installer_app_defaults"],
    min_sdk_version: "33",
    target_sdk_version: "36",
    manifest: "AndroidManifest.xml",
    additional_manifests: [
        "AndroidManifestInstallerPermission.xml",
    ],
}

android_test_helper_app {
    name: "CtsRootEmergencyInstallerApp",
    defaults: ["cts_root_installer_app_defaults"],
    min_sdk_version: "33",
    target_sdk_version: "37",
    manifest: "AndroidManifest.xml",
    package_name: "android.content.pm.cts_root.emergencyinstallerapp",
    additional_manifests: [
        "AndroidManifestEmergencyInstallerPermission.xml",
    ],
}
